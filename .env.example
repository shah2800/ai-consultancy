# Core server
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database and auth
MONGO_URI=mongodb://127.0.0.1:27017/ai-consultancy
JWT_SECRET=replace-with-24+-char-random-secret
ALLOW_PUBLIC_REGISTER=true
DAILY_AI_REPLY_LIMIT=100

# Roles and platform controls
PERMANENT_MANAGER_EMAILS=manager@example.com
PLATFORM_ADMIN_EMAILS=ops@example.com
MAIN_ADMIN_EMAIL=admin@example.com

# Optional: allow boot without Groq for local website/API testing (AI routes may fail until key is set)
ALLOW_MISSING_AI_KEYS=true

# Website ↔ API (Complete System — public student form)
# Copy a workspace owner id from Mongo (AuthUser) — leads created from the website are attached to this user.
WEBSITE_TENANT_USER_ID=replace-with-24-hex-mongodb-objectid
# Shared secret; static site sends X-Website-Form-Token with this value. Required in production.
WEBSITE_FORM_SECRET=replace-with-long-random-string


# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=replace-with-webhook-verify-token
WHATSAPP_TOKEN=replace-with-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_APP_SECRET=replace-with-app-secret

# SMTP for password reset emails (works locally; Render FREE tier blocks ports 587/465)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=replace-with-smtp-password
MAIL_FROM=AI Consultancy <noreply@example.com>

# Recommended on Render free tier — HTTP email API (Gmail SMTP will NOT work on Render free)
# Sign up at https://resend.com — free tier, verify your domain or use their test domain
RESEND_API_KEY=re_replace-with-resend-key
# RESEND_FROM=NextStep <onboarding@resend.dev>

# Alternative to Resend
# SENDGRID_API_KEY=SG.replace-with-sendgrid-key

# Optional public app URL used in invite links
PUBLIC_WEB_ORIGIN=http://localhost:5173
